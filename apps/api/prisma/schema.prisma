generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  portfolios   Portfolio[]

  @@map("users")
}

model Portfolio {
  id              String  @id @default(uuid())
  userId          String  @map("user_id")
  totalCash       Decimal @default(0) @map("total_cash") @db.Decimal(19, 4)
  lockedCash      Decimal @default(0) @map("locked_cash") @db.Decimal(19, 4)
  isMarginEnabled Boolean @default(false) @map("is_margin_enabled")
  lockedMargin    Decimal @default(0) @map("locked_margin") @db.Decimal(19, 4)

  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  orders    Order[]
  user      User                @relation(fields: [userId], references: [id])
  positions Position[]
  snapshots PortfolioSnapshot[]

  @@map("portfolios")
}

model Position {
  id                String         @id @default(uuid())
  portfolioId       String         @map("portfolio_id")
  symbol            String
  quantity          Decimal        @default(0) @db.Decimal(19, 4)
  lockedQuantity    Decimal        @default(0) @map("locked_quantity") @db.Decimal(19, 4)
  averageEntryPrice Decimal        @default(0) @map("average_entry_price") @db.Decimal(19, 4)
  realizedPnl       Decimal        @default(0) @map("realized_pnl") @db.Decimal(19, 4)
  updatedAt         DateTime       @updatedAt @map("updated_at")
  status            PositionStatus @default(OPEN)
  portfolio         Portfolio      @relation(fields: [portfolioId], references: [id])

  @@unique([portfolioId, symbol])
  @@index([symbol])
  @@map("positions")
}

model Order {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  portfolioId       String      @map("portfolio_id")
  symbol            String
  side              OrderSide
  type              OrderType
  requestedQuantity Decimal     @map("requested_quantity") @db.Decimal(19, 4)
  filledQuantity    Decimal     @default(0) @map("filled_quantity") @db.Decimal(19, 4)
  limitPrice        Decimal?    @map("limit_price") @db.Decimal(19, 4)
  stopPrice         Decimal?    @map("stop_price") @db.Decimal(19, 4)
  status            OrderStatus @default(RECEIVED)
  idempotencyKey    String      @map("idempotency_key")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  reservationPrice  Decimal?    @map("reservation_price") @db.Decimal(19, 4)
  reservedMargin    Decimal?    @map("reserved_margin") @db.Decimal(19, 4)
  isLiquidation     Boolean     @default(false) @map("is_liquidation")

  isActivated Boolean     @default(false) @map("is_activated")
  fills       OrderFill[]
  portfolio   Portfolio   @relation(fields: [portfolioId], references: [id])

  @@unique([userId, idempotencyKey], name: "idx_orders_user_idempotency")
  @@index([userId, status], map: "idx_orders_user_status")
  @@index([portfolioId, isLiquidation, status])
  @@map("orders")
}

model OrderFill {
  id                      String   @id @default(uuid())
  orderId                 String   @map("order_id")
  price                   Decimal  @db.Decimal(19, 4)
  quantity                Decimal  @db.Decimal(19, 4)
  executedAt              DateTime @default(now()) @map("executed_at")
  executionIdempotencyKey String   @default(uuid()) @map("execution_idempotency_key")
  realizedPnl             Decimal  @default(0) @map("realized_pnl") @db.Decimal(19, 4)
  order                   Order    @relation(fields: [orderId], references: [id])

  @@unique([orderId, executionIdempotencyKey])
  @@index([orderId])
  @@map("order_fills")
}

model LedgerTransaction {
  id            String        @id @default(uuid())
  referenceType String        @map("reference_type")
  referenceId   String        @map("reference_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  entries       LedgerEntry[]

  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id @default(uuid())
  transactionId String            @map("transaction_id")
  accountId     String            @map("account_id")
  assetType     String            @map("asset_type")
  assetSymbol   String            @map("asset_symbol")
  debit         Decimal           @default(0) @db.Decimal(19, 4)
  credit        Decimal           @default(0) @db.Decimal(19, 4)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

model OutboxEvent {
  id            String      @id @default(uuid())
  type          String
  payload       Json
  status        EventStatus @default(PENDING)
  createdAt     DateTime    @default(now()) @map("created_at")
  publishedAt   DateTime?   @map("published_at")
  aggregateId   String      @map("aggregate_id")
  aggregateType String      @map("aggregate_type")
  attempts      Int         @default(0)
  error         String?
  nextRetryAt   DateTime?   @map("next_retry_at")

  @@index([status, nextRetryAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
  STOP_LIMIT
}

enum OrderStatus {
  RECEIVED
  VALIDATED
  ACCEPTED
  PENDING
  PARTIALLY_FILLED
  FILLED
  REJECTED
  CANCELLED
  EXPIRED
}

enum EventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum PositionStatus {
  OPEN
  CLOSED
}

model MarketTickReceipt {
  tickId      String   @id @map("tick_id")
  symbol      String
  timestamp   DateTime
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("market_tick_receipts")
}

model MarketCandle {
  id                String   @id @default(uuid())
  symbol            String
  timeframe         String
  timestamp         DateTime
  open              Decimal  @db.Decimal(19, 4)
  high              Decimal  @db.Decimal(19, 4)
  low               Decimal  @db.Decimal(19, 4)
  close             Decimal  @db.Decimal(19, 4)
  volume            Decimal  @default(0) @db.Decimal(19, 4)
  isClosed          Boolean  @default(false) @map("is_closed")
  lastTickTimestamp DateTime @map("last_tick_timestamp")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp(sort: Desc)])
  @@map("market_candles")
}

model PortfolioSnapshot {
  id            String   @id @default(uuid())
  portfolioId   String   @map("portfolio_id")
  snapshotDate  DateTime @map("snapshot_date") @db.Date
  totalCash     Decimal  @map("total_cash") @db.Decimal(19, 4)
  marketValue   Decimal  @map("market_value") @db.Decimal(19, 4)
  totalNav      Decimal  @map("total_nav") @db.Decimal(19, 4)
  unrealizedPnl Decimal  @map("unrealized_pnl") @db.Decimal(19, 4)
  realizedPnl   Decimal  @map("realized_pnl") @db.Decimal(19, 4)
  isStale       Boolean  @default(false) @map("is_stale")
  createdAt     DateTime @default(now()) @map("created_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id])

  @@unique([portfolioId, snapshotDate])
  @@index([portfolioId, snapshotDate(sort: Desc)])
  @@map("portfolio_snapshots")
}
